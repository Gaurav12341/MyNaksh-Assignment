APP_ENV=local
MOCK_SERVICE_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# mock | openrouter | lmstudio | openai_compatible
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# OpenRouter
OPENROUTER_API_KEY=

# LM Studio or another OpenAI-compatible server
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=

# Optional; POC falls back to mock dictionaries when empty
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=mynaksh_poc

AUTH_SECRET=dev-only-change-me
FRONTEND_BASE_URL=http://127.0.0.1:5173

STRIPE_SECRET_KEY=
STRIPE_WEEKLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
